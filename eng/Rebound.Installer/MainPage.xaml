<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Rebound.Installer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:core="using:Rebound.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Rebound.Installer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mods="using:Rebound.Forge.Mods"
    xmlns:userControls="using:Rebound.Core.UI.UserControls"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToInverseVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <userControls:LightSceneHeader Margin="0,32,0,0">
            <userControls:LightSceneHeader.SceneContent>
                <Grid VerticalAlignment="Center">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Welcome to" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <Image Width="48" Source="/Assets/Rebound.ico" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Bold"
                                Text="Rebound">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 1">
                                        <LinearGradientBrush.GradientStops>
                                            <GradientStop Offset="1" Color="#7dd1ff" />
                                            <GradientStop Color="#367ef1" />
                                        </LinearGradientBrush.GradientStops>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Fluent design, brought to you everywhere." />
                    </StackPanel>
                </Grid>
            </userControls:LightSceneHeader.SceneContent>
        </userControls:LightSceneHeader>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="1"
                Padding="24"
                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind core:Variables.ReboundVersion}" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Width="120"
                        Command="{x:Bind CancelCommand}"
                        Content="Cancel" />
                    <Button
                        Width="200"
                        Command="{x:Bind InstallCommand}"
                        Content="Update Rebound Hub"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind mods:Catalog.ReboundHub.IsInstalled, Mode=OneWay}" />
                    <Button
                        Width="200"
                        Command="{x:Bind InstallCommand}"
                        Content="Install Rebound Hub"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind mods:Catalog.ReboundHub.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}" />
                </StackPanel>
            </Grid>
            <ProgressBar
                Margin="0,-2"
                Background="Transparent"
                Maximum="{x:Bind mods:Catalog.ReboundHub.TaskCount, Mode=OneWay}"
                Value="{x:Bind mods:Catalog.ReboundHub.Progress, Mode=OneWay}" />
        </Grid>
        <TitleBar
            Title="Rebound Hub Installer"
            VerticalAlignment="Top"
            Subtitle="BETA">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Installer.ico" />
            </TitleBar.IconSource>
        </TitleBar>
    </Grid>
</Page>
