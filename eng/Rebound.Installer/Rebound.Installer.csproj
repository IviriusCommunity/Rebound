<Project Sdk="Microsoft.NET.Sdk">

	<!-- Application -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<UseWinUI>true</UseWinUI>
		<UseWinUITools>true</UseWinUITools>
		<WinUISDKReferences>false</WinUISDKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>

		<AssemblyName>Rebound.Installer</AssemblyName>
		<RootNamespace>Rebound.Installer</RootNamespace>
		<DefaultLanguage>en-US</DefaultLanguage>
		<ApplicationIcon>Assets\Installer.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>

		<PublishSingleFile>true</PublishSingleFile>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	</PropertyGroup>

	<!-- Framework and platforms -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>

		<Platforms>x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

		<PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64' or '$(Platform)' == 'ARM64'">arm64</PlatformTarget>
		<PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(Platform)' == 'x64'">x64</PlatformTarget>
		<PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
	</PropertyGroup>

	<!-- Language and analysis -->
	<PropertyGroup>
		<AnalysisMode>All</AnalysisMode>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- NativeAOT and trimming -->
	<PropertyGroup>
		<PublishTrimmed>true</PublishTrimmed>
		<PublishAot>false</PublishAot>
		<SelfContained>true</SelfContained>

		<EnableComInterop>true</EnableComInterop>
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<UseSourceGenerators>true</UseSourceGenerators>
		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>

		<OptimizationPreference>Speed</OptimizationPreference>
		<IlcOptimizationPreference>Speed</IlcOptimizationPreference>

		<EnableDefaultPageItems>false</EnableDefaultPageItems>
		<EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
		<EnableDefaultPriItems>true</EnableDefaultPriItems>

		<UseWindowsAppSDKBootstrapper>true</UseWindowsAppSDKBootstrapper>

		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	</PropertyGroup>

	<!-- Versioning -->
	<PropertyGroup>
		<Version>0.0.11</Version>
		<AssemblyVersion>0.0.11</AssemblyVersion>
		<FileVersion>0.0.11</FileVersion>
	</PropertyGroup>

	<!-- Publishing -->
	<PropertyGroup>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Hub\Rebound.Hub.cer" />
	  <None Remove="Hub\Rebound.Hub.msixbundle" />
	  <None Remove="MainPage.xaml" />
	  <None Remove="MainWindow.xaml" />
	</ItemGroup>

	<!-- NuGet dependencies -->
	<ItemGroup>
		<!-- Windows interop -->
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Windows App SDK -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
		<PackageReference Include="WinUIEx" Version="2.9.3" />

		<!-- Excluded runtime and compile assets -->
		<PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.3.42" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" ExcludeAssets="all" />

		<!-- CommunityToolkit -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Triggers" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.Labs.WinUI.DependencyPropertyGenerator" Version="0.1.260203-build.2518" />
	</ItemGroup>

	<!-- Application content and XAML -->
	<ItemGroup>
		<AppxTargetDeviceFamilyItem Include="Windows.Desktop" />

		<Manifest Include="$(ApplicationManifest)" />

		<ApplicationDefinition Include="App.xaml" />

		<Content Include="Hub\Rebound.Hub.cer">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>

		<Content Include="Hub\Rebound.Hub.msixbundle">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>

		<Page Include="MainPage.xaml" />

		<Page Include="MainWindow.xaml" />

		<None Update="README.md" Pack="true" PackagePath="\" />

	</ItemGroup>

	<!-- Project references -->
	<ItemGroup>
		<ProjectReference Include="..\..\src\core\Rebound.Core\Rebound.Core.csproj" />
		<ProjectReference Include="..\..\src\core\Rebound.Core.IPC\Rebound.Core.IPC.csproj" />
		<ProjectReference Include="..\..\src\core\Rebound.Core.Native\Rebound.Core.Native.csproj" />
		<ProjectReference Include="..\..\src\core\Rebound.Core.SystemInformation\Rebound.Core.SystemInformation.csproj" />
		<ProjectReference Include="..\..\src\core\Rebound.Core.UI\Rebound.Core.UI.csproj" />
		<ProjectReference Include="..\..\src\core\forge\Rebound.Forge\Rebound.Forge.csproj" />
	</ItemGroup>

	<!-- Content -->
	<ItemGroup Label="Content">
		<Content Update="Assets\Installer.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Update="Assets\Rebound.ico">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Page Update="MainPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>

</Project>