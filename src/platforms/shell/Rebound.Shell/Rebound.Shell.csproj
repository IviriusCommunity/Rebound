<Project Sdk="Microsoft.NET.Sdk">

	<!-- Application -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<UseWinUI>true</UseWinUI>
		<UseWinUITools>true</UseWinUITools>
		<WinUISDKReferences>false</WinUISDKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>

		<AssemblyName>Rebound.Shell</AssemblyName>
		<RootNamespace>Rebound.Shell</RootNamespace>
		<DefaultLanguage>en-US</DefaultLanguage>
		<ApplicationIcon>Assets\ReboundShell.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<!-- Framework and platforms -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>

		<Platforms>x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>

		<PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64' or '$(Platform)' == 'ARM64'">arm64</PlatformTarget>
		<PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(Platform)' == 'x64'">x64</PlatformTarget>
	</PropertyGroup>

	<!-- Language and analysis -->
	<PropertyGroup>
		<AnalysisMode>All</AnalysisMode>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- NativeAOT and trimming -->
	<PropertyGroup>
		<PublishTrimmed>true</PublishTrimmed>
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>

		<EnableComInterop>true</EnableComInterop>
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<UseSourceGenerators>true</UseSourceGenerators>
		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>

		<OptimizationPreference>Speed</OptimizationPreference>
		<IlcOptimizationPreference>Speed</IlcOptimizationPreference>

		<UseWindowsAppSDKBootstrapper>true</UseWindowsAppSDKBootstrapper>
		<WindowsAppSdkSelfContained>false</WindowsAppSdkSelfContained>

		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	</PropertyGroup>

	<!-- Versioning -->
	<PropertyGroup>
		<Version>0.0.11</Version>
		<AssemblyVersion>0.0.11</AssemblyVersion>
		<FileVersion>0.0.11</FileVersion>
	</PropertyGroup>

	<!-- MSIX packaging -->
	<PropertyGroup>
		<AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>

		<AppxBundle>Always</AppxBundle>
		<AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>

		<GenerateTestArtifacts>true</GenerateTestArtifacts>
		<GenerateAppInstallerFile>false</GenerateAppInstallerFile>

		<PackageCertificateKeyFile>$(SolutionDir)\src\Rebound.Hub_TemporaryKey.pfx</PackageCertificateKeyFile>
	</PropertyGroup>

	<!-- NuGet dependencies -->
	<ItemGroup>
		<!-- Windows interop -->
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Windows App SDK -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
		<PackageReference Include="WinUIEx" Version="2.9.3" />

		<!-- Excluded runtime and compile assets -->
		<PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.5" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.5" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.5.96" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" ExcludeAssets="all" />

		<!-- CommunityToolkit -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Triggers" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.Labs.WinUI.DependencyPropertyGenerator" Version="0.1.261027-build.2704" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Assets\RunBox.ico" />
	  <None Remove="Launcher.obj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="NativeMethods.json" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="Assets\Applets\RunBox.ico">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Update="Assets\ReboundShell.ico">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Update="Assets\Applets\Shutdown.ico">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!-- Project references -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\core\Rebound.Core\Rebound.Core.csproj" />
		<ProjectReference Include="..\..\..\core\Rebound.Core.IPC\Rebound.Core.IPC.csproj" />
		<ProjectReference Include="..\..\..\core\Rebound.Core.Native\Rebound.Core.Native.csproj" />
		<ProjectReference Include="..\..\..\core\Rebound.Core.SystemInformation\Rebound.Core.SystemInformation.csproj" />
		<ProjectReference Include="..\..\..\core\Rebound.Core.UI\Rebound.Core.UI.csproj" />
		<ProjectReference Include="..\..\..\core\forge\Rebound.Forge\Rebound.Forge.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Views\RunPage.xaml.cs">
	    <DependentUpon>RunPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\ShutdownPage.xaml.cs">
	    <DependentUpon>ShutdownPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <Page Update="Views\RunPage.xaml">
	    <SubType>Designer</SubType>
	  </Page>
	  <Page Update="Views\ShutdownPage.xaml">
	    <SubType>Designer</SubType>
	  </Page>
	</ItemGroup>

</Project>