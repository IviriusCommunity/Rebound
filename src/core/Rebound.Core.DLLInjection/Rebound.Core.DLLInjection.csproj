<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Code Analysis and Trimming -->
		<AnalysisMode>All</AnalysisMode>

		<!-- Language and Code Configuration -->
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<Platforms>x64;ARM64</Platforms>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <AdditionalFiles Include="NativeMethods.json">
	    <Generator>MSBuild:Compile</Generator>
	  </AdditionalFiles>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<ProjectReference Include="..\Rebound.Core.Native\Rebound.Core.Native.csproj" />

		<ProjectReference Include="..\Rebound.External.Files\Rebound.External.Files.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <AdditionalFiles Update="NativeMethods.txt">
	    <Generator>MSBuild:Compile</Generator>
	  </AdditionalFiles>
	</ItemGroup>

</Project>
