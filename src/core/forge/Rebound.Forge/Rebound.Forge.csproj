<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Code Analysis and Trimming -->
		<AnalysisMode>All</AnalysisMode>

		<!-- Language and Code Configuration -->
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
		<Platforms>x64;ARM64</Platforms>

		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <AdditionalFiles Include="NativeMethods.json">
	    <Generator>MSBuild:Compile</Generator>
	  </AdditionalFiles>
	  <AdditionalFiles Include="NativeMethods.txt">
	    <Generator>MSBuild:Compile</Generator>
	  </AdditionalFiles>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Rebound.Core.DLLInjection\Rebound.Core.DLLInjection.csproj" />
		<ProjectReference Include="..\..\Rebound.Core.Native\Rebound.Core.Native.csproj" />
		<ProjectReference Include="..\..\Rebound.Core.Storage\Rebound.Core.Storage.csproj" />
		<ProjectReference Include="..\..\Rebound.Core\Rebound.Core.csproj" />
	</ItemGroup>

</Project>
