<Page
    x:Class="Rebound.Hub.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cards="using:Rebound.Hub.Cards"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gallery="using:WinUIGallery.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:userControls="using:Rebound.Core.UI.UserControls"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ImageSource x:Key="HeroImage">/Assets/Backgrounds/WallpaperLight.png</ImageSource>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ImageSource x:Key="HeroImage">/Assets/Backgrounds/WallpaperDark.png</ImageSource>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="280" />
                <RowDefinition Height="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <userControls:LightSceneHeader>
                <userControls:LightSceneHeader.SceneContent>
                    <StackPanel Margin="24,0,0,0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <Image Width="48" Source="/Assets/AppIcons/IviriusCommunityIcon.png" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="36"
                                FontWeight="Bold"
                                Text="Ivirius Community">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 1">
                                        <LinearGradientBrush.GradientStops>
                                            <GradientStop Offset="1" Color="#e4fff2" />
                                            <GradientStop Color="#88bfa3" />
                                        </LinearGradientBrush.GradientStops>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Fluent design, brought to you everywhere." />
                        <TextBlock Foreground="LightGray" Text="Grow together, develop for the people." />
                    </StackPanel>
                </userControls:LightSceneHeader.SceneContent>
            </userControls:LightSceneHeader>

            <StackPanel Grid.Row="1">
                <Grid Height="2">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 1">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="{ThemeResource SystemAccentColorLight2}" />
                                <GradientStop Offset="1" Color="{ThemeResource SystemAccentColor}" />
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow Color="{ThemeResource SystemAccentColorLight2}" />
                    </ui:Effects.Shadow>
                </Grid>
            </StackPanel>

            <ScrollViewer
                Grid.RowSpan="2"
                Margin="0,0,0,32"
                Padding="48,0"
                VerticalAlignment="Bottom"
                CanContentRenderOutsideBounds="True"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind LinkCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="cards:LinkCard">
                            <Grid CornerRadius="8">
                                <Grid.Background>
                                    <media:AcrylicBrush
                                        BlurAmount="12"
                                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                        TintOpacity="0.5" />
                                </Grid.Background>
                                <Button
                                    Width="240"
                                    Height="220"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent"
                                    CornerRadius="8">
                                    <interactivity:Interaction.Behaviors>
                                        <interactivity:EventTriggerBehavior EventName="Tapped">
                                            <behaviors:NavigateToUriAction NavigateUri="{x:Bind Link}" />
                                        </interactivity:EventTriggerBehavior>
                                    </interactivity:Interaction.Behaviors>
                                    <Grid>
                                        <StackPanel
                                            Margin="8,16"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top">
                                            <Grid
                                                Width="64"
                                                Height="64"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                                <Image
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Source="{x:Bind IconPath}" />
                                            </Grid>
                                            <TextBlock
                                                Margin="0,16,0,0"
                                                FontSize="20"
                                                Text="{x:Bind Title}" />
                                            <TextBlock
                                                Margin="0,5,0,0"
                                                FontSize="11"
                                                Opacity="0.7"
                                                Text="{x:Bind Description}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <FontIcon
                                            Margin="8,12"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="15"
                                            Glyph="" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                Grid.Row="2"
                Margin="48,0,0,24"
                FontSize="28"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Featured Apps" />

            <ItemsControl
                Grid.Row="3"
                Margin="48,0,48,48"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemsSource="{x:Bind AppCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="cards:AppCard">
                        <Grid Width="320">
                            <ui:Effects.Shadow>
                                <media:AttachedCardShadow
                                    BlurRadius="24"
                                    CornerRadius="8"
                                    Opacity="0.4"
                                    Offset="0, 8"
                                    Color="Black" />
                            </ui:Effects.Shadow>
                            <Border CornerRadius="8" Opacity="0.2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind AccentColor}" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <AcrylicBrush
                                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                        TintLuminosityOpacity="1"
                                        TintOpacity="0.5" />
                                </Border.Background>
                            </Border>
                            <Button
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                CornerRadius="8">
                                <interactivity:Interaction.Behaviors>
                                    <interactivity:EventTriggerBehavior EventName="Tapped">
                                        <behaviors:NavigateToUriAction NavigateUri="{x:Bind Link}" />
                                    </interactivity:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                                <Grid>
                                    <Grid
                                        Margin="12"
                                        ColumnSpacing="8"
                                        RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.RowSpan="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                            <Grid
                                                Width="64"
                                                Height="64"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                CornerRadius="4">
                                                <Image
                                                    Margin="-16"
                                                    Source="{x:Bind IconPath}"
                                                    Stretch="Fill" />
                                                <Border
                                                    BorderBrush="{ThemeResource SolidBackgroundFillColorBase}"
                                                    BorderThickness="2"
                                                    CornerRadius="3" />
                                                <Border CornerRadius="4">
                                                    <Border.Background>
                                                        <AcrylicBrush
                                                            TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                                            TintLuminosityOpacity="1"
                                                            TintOpacity="0.7" />
                                                    </Border.Background>
                                                    <Image
                                                        Width="40"
                                                        Height="40"
                                                        Margin="8"
                                                        Source="{x:Bind IconPath}" />
                                                </Border>
                                                <Border
                                                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                                    BorderThickness="2"
                                                    CornerRadius="4" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,-12,0,0"
                                            FontSize="12"
                                            Opacity="0.5"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            BorderBrush="{ThemeResource AccentButtonBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <StackPanel.Background>
                                                <SolidColorBrush Color="{x:Bind AccentColor}" />
                                            </StackPanel.Background>
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Publisher}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind AccentTextColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid
                                            Grid.Row="3"
                                            Grid.ColumnSpan="2"
                                            Height="160"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            CornerRadius="4">
                                            <Image
                                                Margin="4"
                                                Source="{x:Bind PicturePath}"
                                                Stretch="Fill" />
                                            <Border>
                                                <Border.Background>
                                                    <media:AcrylicBrush BlurAmount="24" TintColor="{ThemeResource SolidBackgroundFillColorBase}" />
                                                </Border.Background>
                                                <Image
                                                    Margin="16"
                                                    Source="{x:Bind PicturePath}"
                                                    Stretch="Uniform" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>