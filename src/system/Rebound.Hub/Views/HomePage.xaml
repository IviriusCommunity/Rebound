<Page
    x:Class="Rebound.Hub.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cards="using:Rebound.Hub.Cards"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gallery="using:WinUIGallery.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:userControls="using:Rebound.Core.UI.UserControls"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <ImageSource x:Key="HeroImage">/Assets/Backgrounds/WallpaperLight.png</ImageSource>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ImageSource x:Key="HeroImage">/Assets/Backgrounds/WallpaperDark.png</ImageSource>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="280" />
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <userControls:LightSceneHeader>
                <userControls:LightSceneHeader.SceneContent>
                    <StackPanel Margin="24,0,0,0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <Image Width="48" Source="/Assets/AppIcons/IviriusCommunityIcon.png" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="36"
                                FontWeight="Bold"
                                Text="Ivirius Community">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 1">
                                        <LinearGradientBrush.GradientStops>
                                            <GradientStop Offset="1" Color="#e4fff2" />
                                            <GradientStop Color="#88bfa3" />
                                        </LinearGradientBrush.GradientStops>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Fluent design, brought to you everywhere." />
                        <TextBlock Foreground="LightGray" Text="Grow together, develop for the people." />
                    </StackPanel>
                </userControls:LightSceneHeader.SceneContent>
            </userControls:LightSceneHeader>

            <StackPanel Grid.Row="1">
                <Grid Height="2">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 1">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="{ThemeResource SystemAccentColorLight2}" />
                                <GradientStop Offset="1" Color="{ThemeResource SystemAccentColor}" />
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow Color="{ThemeResource SystemAccentColorLight2}" />
                    </ui:Effects.Shadow>
                </Grid>
            </StackPanel>

            <ScrollViewer
                Grid.RowSpan="2"
                Margin="0,0,0,32"
                Padding="48,0"
                VerticalAlignment="Bottom"
                CanContentRenderOutsideBounds="True"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind LinkCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="cards:LinkCard">
                            <Grid CornerRadius="8">
                                <Grid.Background>
                                    <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}" TintOpacity="0.5" />
                                </Grid.Background>
                                <Button
                                    Width="240"
                                    Height="180"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Background="Transparent"
                                    CornerRadius="8">
                                    <interactivity:Interaction.Behaviors>
                                        <interactivity:EventTriggerBehavior EventName="Tapped">
                                            <behaviors:NavigateToUriAction NavigateUri="{x:Bind Link}" />
                                        </interactivity:EventTriggerBehavior>
                                    </interactivity:Interaction.Behaviors>
                                    <Grid>
                                        <StackPanel
                                            Margin="8,16"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top">
                                            <Grid
                                                Width="40"
                                                Height="40"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                                <Image
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Source="{x:Bind IconPath}" />
                                            </Grid>
                                            <TextBlock
                                                Margin="0,16,0,0"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}" />
                                            <TextBlock
                                                Margin="0,5,0,0"
                                                FontSize="11"
                                                Opacity="0.7"
                                                Text="{x:Bind Description}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <FontIcon
                                            Margin="8,12"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="12"
                                            Glyph="&#xE8A7;" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                Grid.Row="2"
                Margin="48,0,0,24"
                FontSize="28"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Featured Apps" />

            <ItemsControl
                Grid.Row="3"
                Margin="48,0,48,48"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemsSource="{x:Bind AppCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="cards:AppCard">
                        <Grid Width="320">
                            <Button
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                CornerRadius="8">
                                <interactivity:Interaction.Behaviors>
                                    <interactivity:EventTriggerBehavior EventName="Tapped">
                                        <behaviors:NavigateToUriAction NavigateUri="{x:Bind Link}" />
                                    </interactivity:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                                <Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.ColumnSpan="2"
                                                Height="104"
                                                VerticalAlignment="Top"
                                                Opacity="0.35"
                                                Source="{x:Bind IconPath}"
                                                Stretch="Fill" />
                                            <Border Grid.RowSpan="2" Grid.ColumnSpan="2">
                                                <Border.Background>
                                                    <AcrylicBrush
                                                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                                        TintLuminosityOpacity="0.75"
                                                        TintOpacity="0" />
                                                </Border.Background>
                                            </Border>
                                            <Image
                                                Width="40"
                                                Margin="16"
                                                Source="{x:Bind IconPath}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="0,12,16,0"
                                                Spacing="4">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind Publisher}" />
                                                <TextBlock
                                                    VerticalAlignment="Top"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid
                                            Grid.Row="1"
                                            Height="200"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            CornerRadius="0,0,7,7">
                                            <Image
                                                Margin="16"
                                                Opacity="0.5"
                                                Source="{x:Bind PicturePath}"
                                                Stretch="Fill" />
                                            <Border>
                                                <Border.Background>
                                                    <media:BackdropBlurBrush Amount="32" />
                                                </Border.Background>
                                                <Border
                                                    Margin="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4">
                                                    <Image Source="{x:Bind PicturePath}" Stretch="Uniform" />
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>