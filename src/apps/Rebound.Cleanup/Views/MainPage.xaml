<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Rebound.Cleanup.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:items="using:Rebound.Cleanup.Items"
    xmlns:local="using:Rebound.Cleanup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:winuiex="using:WinUIEx"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:FileSizeToFriendlyStringConverter x:Key="FileSizeToFriendlyStringConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToObjectConverter
            x:Key="BoolToInverseVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
    </Page.Resources>
    <Grid>
        <SystemBackdropElement>
            <SystemBackdropElement.SystemBackdrop>
                <MicaBackdrop />
            </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>
        <TitleBar
            x:Name="TitleBarControl"
            Title="Disk Cleanup"
            VerticalAlignment="Top"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested"
            Subtitle="BETA">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/cleanmgr.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <Grid Margin="0,32,0,0" RowSpacing="8">
            <NavigationView
                x:Name="NavView"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                ItemInvoked="NavView_ItemInvoked"
                OpenPaneLength="240"
                SizeChanged="NavigationView_SizeChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Name="DiskCleanupItem"
                        Content="Cleanup"
                        IsSelected="True">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEA99;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Disk Analyzer" IsEnabled="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEB05;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem
                        Content="Delete Shadow Copies"
                        SelectsOnInvoked="False"
                        Tag="DeleteShadowCopies">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xED62;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        Content="Programs and Features"
                        SelectsOnInvoked="False"
                        Tag="ProgramsAndFeatures">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE74C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        Content="Storage Sense"
                        SelectsOnInvoked="False"
                        Tag="StorageSense">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEDA2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        Content="Disk Management"
                        SelectsOnInvoked="False"
                        Tag="DiskManagement">
                        <NavigationViewItem.Icon>
                            <ImageIcon Source="/Assets/Tools/DiskManagement.ico" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        Content="Optimize Drives"
                        SelectsOnInvoked="False"
                        Tag="OptimizeDrives">
                        <NavigationViewItem.Icon>
                            <ImageIcon Source="/Assets/Tools/Defragment.ico" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Grid>
                    <Grid Visibility="{x:Bind DiskCleanupItem.IsSelected, Mode=OneWay}">
                        <Grid Visibility="{x:Bind ViewModel.CompactLayout, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    Header="Selected drive"
                                    ItemsSource="{x:Bind ViewModel.DriveItems, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedDriveIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="items:DriveComboBoxItem">
                                            <Grid>
                                                <FontIcon
                                                    HorizontalAlignment="Left"
                                                    FontSize="16"
                                                    Glyph="&#xEDA2;" />
                                                <TextBlock
                                                    Margin="24,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind DriveName, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.RelaunchAsAdminCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsRunningAsAdmin, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ImageIcon Width="16" Source="ms-appx:///Assets/Administrator.png" />
                                        <TextBlock Text="Clean up system files" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind RefreshCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                        <TextBlock Text="Refresh" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid
                                Grid.Row="1"
                                Padding="0,8,16,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="56"
                                    Margin="16,0,0,0"
                                    IsChecked="{x:Bind ViewModel.IsEverythingSelected, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}" />
                                <Border
                                    Width="1"
                                    Margin="0,0,16,0"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentOperation, Mode=OneWay}" />
                                    <ProgressBar Maximum="{x:Bind ViewModel.MaxProgress, Mode=OneWay}" Value="{x:Bind ViewModel.CurrentProgress, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.CurrentTask, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind ViewModel.SelectedFilesCount, Mode=OneWay}" />
                                        <Run Text=" selected files" />
                                    </TextBlock>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind ViewModel.SelectedFilesSize, Mode=OneWay, Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                                        <Run Text=" selected file size" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind ViewModel.FilesCount, Mode=OneWay}" />
                                        <Run Text=" total files" />
                                    </TextBlock>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind ViewModel.FilesSize, Mode=OneWay, Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                                        <Run Text=" total file size" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <ListView
                                x:Name="ItemsListViewLarge"
                                Grid.Row="2"
                                Padding="0,2"
                                IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.CleanItems, Mode=OneWay}"
                                SelectedIndex="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="items:CleanItem">
                                        <Grid
                                            Margin="0,6"
                                            ColumnSpacing="8"
                                            ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                Checked="CheckBox_Checked"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Unchecked="CheckBox_Checked" />
                                            <ImageIcon
                                                Grid.Column="1"
                                                Width="16"
                                                HorizontalAlignment="Left"
                                                Source="{x:Bind ImagePath, Mode=OneWay}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Description, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind IsEnumerated, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                                                <ProgressRing
                                                    Width="16"
                                                    Height="16"
                                                    IsIndeterminate="True" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Opacity="0.5"
                                                    Text="Indexing..." />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind FileCount, Mode=OneWay}" />
                                                <Run Text=" files" />
                                            </TextBlock>
                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Size, Mode=OneWay, Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid
                                Grid.Row="3"
                                Height="80"
                                Padding="24"
                                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Width="120"
                                        Command="{x:Bind ViewModel.ViewFilesCommand}"
                                        CommandParameter="{x:Bind ItemsListViewLarge.SelectedIndex, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                                            <TextBlock Text="View files" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Width="120"
                                        Command="{x:Bind ViewModel.DeleteCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xEA99;" />
                                            <TextBlock Text="Clean" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Width="120"
                                        Command="{x:Bind CloseCommand}"
                                        Content="Close"
                                        IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Escape" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Grid RowSpacing="8" Visibility="{x:Bind ViewModel.CompactLayout, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                MaxWidth="800"
                                Margin="24,24,24,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Header="Selected drive"
                                ItemsSource="{x:Bind ViewModel.DriveItems, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.SelectedDriveIndex, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="items:DriveComboBoxItem">
                                        <Grid>
                                            <FontIcon
                                                HorizontalAlignment="Left"
                                                FontSize="16"
                                                Glyph="&#xEDA2;" />
                                            <TextBlock
                                                Margin="24,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind DriveName, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <InfoBar
                                Title="Hover over an item for its description."
                                Grid.Row="1"
                                MaxWidth="800"
                                Margin="24,0"
                                IsClosable="False"
                                IsOpen="True" />
                            <Grid
                                Grid.Row="2"
                                MaxWidth="800"
                                Margin="24,0">
                                <CheckBox
                                    Content="Select all"
                                    IsChecked="{x:Bind ViewModel.IsEverythingSelected, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind RefreshCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                        <TextBlock Text="Refresh" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListView
                                x:Name="ItemsListView"
                                Grid.Row="3"
                                MaxWidth="800"
                                Margin="24,0"
                                Padding="4,6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                CornerRadius="4"
                                IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.CleanItems, Mode=OneWay}"
                                SelectedIndex="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="items:CleanItem">
                                        <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                Checked="CheckBox_Checked"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Unchecked="CheckBox_Checked" />
                                            <ImageIcon
                                                Grid.Column="1"
                                                Width="16"
                                                HorizontalAlignment="Left"
                                                Source="{x:Bind ImagePath, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel
                                                Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind IsEnumerated, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                                                <ProgressRing
                                                    Width="16"
                                                    Height="16"
                                                    IsIndeterminate="True" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Indexing..." />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Size, Mode=OneWay, Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid
                                Grid.Row="4"
                                MaxWidth="800"
                                Margin="24,0">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ViewModel.SelectedFilesCount, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{x:Bind ViewModel.FilesCount, Mode=OneWay}" />
                                    <Run Text=" files" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ViewModel.SelectedFilesSize, Mode=OneWay, Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                                    <Run Text="/" />
                                    <Run Text="{x:Bind ViewModel.FilesSize, Mode=OneWay, Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                                </TextBlock>
                            </Grid>
                            <StackPanel
                                Grid.Row="5"
                                MaxWidth="800"
                                Margin="24,0"
                                Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.CurrentOperation, Mode=OneWay}" />
                                <ProgressBar Maximum="{x:Bind ViewModel.MaxProgress, Mode=OneWay}" Value="{x:Bind ViewModel.CurrentProgress, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.CurrentTask, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid
                                Grid.Row="6"
                                MaxWidth="800"
                                Margin="24,4,24,8">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{x:Bind ViewModel.RelaunchAsAdminCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsRunningAsAdmin, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ImageIcon Width="16" Source="ms-appx:///Assets/Administrator.png" />
                                            <TextBlock Text="Clean up system files" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{x:Bind ViewModel.ViewFilesCommand}"
                                        CommandParameter="{x:Bind ItemsListView.SelectedIndex, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                                            <TextBlock Text="View files" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid
                                Grid.Row="7"
                                Height="80"
                                Padding="24"
                                Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}">
                                <Grid MaxWidth="800">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="1"
                                        Width="120"
                                        Command="{x:Bind ViewModel.DeleteCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xEA99;" />
                                            <TextBlock Text="Clean" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        Width="120"
                                        Command="{x:Bind CloseCommand}"
                                        Content="Close"
                                        IsEnabled="{x:Bind ViewModel.CanItemsBeClicked, Mode=OneWay}">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Escape" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Page>