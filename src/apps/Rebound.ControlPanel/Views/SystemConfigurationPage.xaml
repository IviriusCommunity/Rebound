<Page
    x:Class="Rebound.ControlPanel.Views.SystemConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Rebound.ControlPanel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToInverseVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Image
                Width="16"
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="/Assets/Glyphs/Configuration.ico" />
            <TextBlock
                Margin="48,10,16,0"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="Configuration"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Margin="48,36,16,12"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Generic system configuration and properties."
                TextWrapping="WrapWholeWords" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="1000"
                Margin="40"
                Spacing="8">
                <toolkit:SettingsCard
                    Description="Manage the settings that don't appear here."
                    Header="Windows Settings"
                    IsClickEnabled="True">
                    <interactivity:Interaction.Behaviors>
                        <interactivity:EventTriggerBehavior EventName="Tapped">
                            <behaviors:NavigateToUriAction NavigateUri="ms-settings:system" />
                        </interactivity:EventTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="/Assets/Glyphs/WindowsSettings.ico" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8AD;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="Computer information" />
                <muxc:InfoBar
                    Title="These settings require administrator privileges to edit."
                    IsClosable="False"
                    IsOpen="True"
                    Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <muxc:InfoBar.ActionButton>
                        <Button Command="{x:Bind RelaunchAsAdminCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xEA18;" />
                                <TextBlock Text="Relaunch as Administrator" />
                            </StackPanel>
                        </Button>
                    </muxc:InfoBar.ActionButton>
                </muxc:InfoBar>
                <toolkit:SettingsCard
                    Description="The display name of your computer. Only letters, numbers and hyphens allowed, max 15 characters. Cannot start or end with a hyphen. Requires a restart to apply."
                    Header="Computer name"
                    IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.ComputerName, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ChangeComputerNameCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Edit">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="The description of your computer."
                    Header="Computer description"
                    IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.ComputerDescription, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ChangeComputerDescriptionCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Edit">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                    </StackPanel>
                </toolkit:SettingsCard>
                <muxc:InfoBar
                    Title="You will need to restart in order for the computer name to be fully updated."
                    IsOpen="{x:Bind ViewModel.IsRestartRequired, Mode=TwoWay}"
                    Severity="Warning">
                    <muxc:InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.RestartCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE777;" />
                                <TextBlock Text="Restart now" />
                            </StackPanel>
                        </Button>
                    </muxc:InfoBar.ActionButton>
                </muxc:InfoBar>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="Hardware" />
                <toolkit:SettingsCard
                    Command="{x:Bind LaunchDeviceManagerCommand}"
                    Description="Manage connected devices and device drivers."
                    Header="Device Manager"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEB66;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8AD;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>
                <muxc:InfoBar
                    Title="This setting requires administrator privileges to view and edit."
                    IsClosable="False"
                    IsOpen="True"
                    Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <muxc:InfoBar.ActionButton>
                        <Button Command="{x:Bind RelaunchAsAdminCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xEA18;" />
                                <TextBlock Text="Relaunch as Administrator" />
                            </StackPanel>
                        </Button>
                    </muxc:InfoBar.ActionButton>
                </muxc:InfoBar>
                <toolkit:SettingsCard
                    Description="Controls whether Windows automatically downloads device metadata and OEM apps from the Windows Metadata and Internet Services (WMIS) server for connected devices. When enabled, Windows will silently install manufacturer apps (e.g. Lenovo Vantage) upon connecting hardware. Disable to prevent unsolicited OEM software installation."
                    Header="OEM apps"
                    IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74C;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.InstallOemApps, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay}" />
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
