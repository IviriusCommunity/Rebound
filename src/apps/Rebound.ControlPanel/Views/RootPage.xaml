<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Rebound.ControlPanel.Views.RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Rebound.ControlPanel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rconverters="using:Rebound.Core.UI.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToInverseVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
        <rconverters:StringToUriConverter x:Key="StringToUriConverter" />
        <Style x:Key="DisabledButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AnimatedIcon.State="Normal"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{TemplateBinding Background}"
                            BackgroundSizing="{TemplateBinding BackgroundSizing}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.083" />
                            </ContentPresenter.BackgroundTransition>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="PointerOver">

                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBorderBrushPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonForegroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.(AnimatedIcon.State)" Value="PointerOver" />

                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">

                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBorderBrushPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonForegroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.(AnimatedIcon.State)" Value="Pressed" />

                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Disabled">

                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonForegroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <!--  DisabledVisual Should be handled by the control, not the animated icon.  -->
                                            <Setter Target="ContentPresenter.(AnimatedIcon.State)" Value="Normal" />

                                        </VisualState.Setters>
                                    </VisualState>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <SystemBackdropElement>
            <SystemBackdropElement.SystemBackdrop>
                <MicaBackdrop />
            </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>
        <StackPanel
            Margin="12,8,12,0"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="8">
            <Image
                Width="16"
                VerticalAlignment="Center"
                Source="/Assets/ControlPanel.ico" />
            <TextBlock
                Margin="0,0,0,2"
                VerticalAlignment="Center"
                FontSize="12"
                Text="Control Panel" />
            <Border
                Padding="6,2,6,3"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="2">
                <TextBlock
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="BETA" />
            </Border>
        </StackPanel>
        <Grid
            Margin="4,40,4,8"
            VerticalAlignment="Top"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Width="36"
                    Height="36"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{x:Bind TogglePaneCommand}"
                    ToolTipService.ToolTip="Toggle navigation pane">
                    <AnimatedIcon>
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedGlobalNavigationButtonVisualSource />
                        </AnimatedIcon.Source>
                    </AnimatedIcon>
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{x:Bind GoBackCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                    Style="{StaticResource DisabledButtonStyle}"
                    ToolTipService.ToolTip="Go back">
                    <AnimatedIcon Width="20" Height="20">
                        <animatedvisuals:AnimatedBackVisualSource />
                    </AnimatedIcon>
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="See more"
                    Visibility="{x:Bind ViewModel.CollapseLeftItems, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{x:Bind GoForwardCommand}"
                                IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                                Text="Go forward">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind RefreshCommand}" Text="Refresh">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind GoHomeCommand}" Text="Home">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE80F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{x:Bind GoForwardCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                    Style="{StaticResource DisabledButtonStyle}"
                    ToolTipService.ToolTip="Go forward"
                    Visibility="{x:Bind ViewModel.CollapseLeftItems, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <Grid
                        Width="20"
                        Height="20"
                        RenderTransformOrigin="0.5, 0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="180" />
                        </Grid.RenderTransform>
                        <AnimatedIcon Width="20" Height="20">
                            <animatedvisuals:AnimatedBackVisualSource />
                        </AnimatedIcon>
                    </Grid>
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{x:Bind RefreshCommand}"
                    ToolTipService.ToolTip="Refresh"
                    Visibility="{x:Bind ViewModel.CollapseLeftItems, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{x:Bind GoHomeCommand}"
                    ToolTipService.ToolTip="Home"
                    Visibility="{x:Bind ViewModel.CollapseLeftItems, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <FontIcon FontSize="16" Glyph="&#xE80F;" />
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="AddressBar"
                Grid.Column="1"
                Margin="8,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Home"
                TextTrimming="CharacterEllipsis" />
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="Profile">
                    <Button.Flyout>
                        <Flyout ShouldConstrainToRootBounds="False">
                            <Grid>
                                <StackPanel>
                                    <PersonPicture Width="64" Height="64">
                                        <PersonPicture.ProfilePicture>
                                            <BitmapImage UriSource="{x:Bind UserPicturePath, Mode=OneWay, Converter={StaticResource StringToUriConverter}}" />
                                        </PersonPicture.ProfilePicture>
                                    </PersonPicture>
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Username, Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Local account" />
                                    <StackPanel
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <HyperlinkButton Command="{x:Bind OpenUserFolderCommand}" Content="Open user folder" />
                                        <HyperlinkButton Command="{x:Bind LogOutCommand}" Content="Log out" />
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    Padding="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Command="{x:Bind ManageUserCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Manage user">
                                    <FontIcon FontSize="16" Glyph="&#xEF58;" />
                                </Button>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                    <PersonPicture Width="24" Height="24">
                        <PersonPicture.ProfilePicture>
                            <BitmapImage UriSource="{x:Bind UserPicturePath, Mode=OneWay, Converter={StaticResource StringToUriConverter}}" />
                        </PersonPicture.ProfilePicture>
                    </PersonPicture>
                </Button>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.CollapseRightItems, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Command="{x:Bind OpenSettingsCommand}"
                        ToolTipService.ToolTip="Windows Settings">
                        <AnimatedIcon Width="20" Height="20">
                            <animatedvisuals:AnimatedSettingsVisualSource />
                        </AnimatedIcon>
                    </Button>
                    <Button
                        Height="36"
                        Padding="8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Command="{x:Bind CreateShortcutCommand}"
                        ToolTipService.ToolTip="Create shortcut">
                        <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                    </Button>
                    <DropDownButton
                        Height="36"
                        Padding="8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="Legacy launch"
                        Visibility="{x:Bind ViewModel.IsReboundInstalled, Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="LegacyLaunchDropDownButtonFlyout" />
                        </DropDownButton.Flyout>
                        <FontIcon FontSize="16" Glyph="&#xED56;" />
                    </DropDownButton>
                    <DropDownButton
                        Height="36"
                        Padding="8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="Help">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="DocsDropDownButtonFlyout" />
                        </DropDownButton.Flyout>
                        <FontIcon FontSize="16" Glyph="&#xE897;" />
                    </DropDownButton>
                </StackPanel>
                <DropDownButton
                    Height="36"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="All actions"
                    Visibility="{x:Bind ViewModel.CollapseRightItems, Mode=OneWay}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Command="{x:Bind OpenSettingsCommand}" Text="Windows Settings">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind CreateShortcutCommand}" Text="Create shortcut">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem
                                x:Name="LegacyLaunchFlyoutItem"
                                Text="Legacy launch"
                                Visibility="{x:Bind ViewModel.IsReboundInstalled, Mode=OneWay}">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xED56;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="DocsFlyoutItem" Text="Help">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE897;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                    <FontIcon FontSize="16" Glyph="&#xE71D;" />
                </DropDownButton>
            </StackPanel>
        </Grid>
        <NavigationView
            x:Name="NavView"
            Margin="0,80,0,0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            ItemInvoked="NavigationView_ItemInvoked">
            <Frame
                x:Name="RootFrame"
                x:FieldModifier="public"
                Navigated="RootFrame_Navigated" />
        </NavigationView>
    </Grid>
</Page>