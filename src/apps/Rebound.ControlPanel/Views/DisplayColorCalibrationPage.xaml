                                                        <GradientStop Offset="0.000" Color="#FF0000" />
                                                        <GradientStop Offset="0.167" Color="#FFFF00" />
                                                        <GradientStop Offset="0.333" Color="#00FF00" />
                                                        <GradientStop Offset="0.500" Color="#00FFFF" />
                                                        <GradientStop Offset="0.667" Color="#0000FF" />
                                                        <GradientStop Offset="0.833" Color="#FF00FF" />
                                                        <GradientStop Offset="1.000" Color="#FF0000" />
                                                    </LinearGradientBrush.GradientStops>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border
                                            Width="400"
                                            Height="400"
                                            CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0, 0" EndPoint="0, 1">
                                                    <LinearGradientBrush.GradientStops>
                                                        <GradientStop Offset="0.000" Color="#000000" />
                                                        <GradientStop Offset="0.500" Color="#00000000" />
                                                        <GradientStop Offset="0.500" Color="#00FFFFFF" />
                                                        <GradientStop Offset="1.000" Color="#FFFFFF" />
                                                    </LinearGradientBrush.GradientStops>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Viewbox>
                                <Grid Background="{x:Bind OriginalBrush, Mode=OneWay}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="1" Background="{x:Bind ModifiedBrush, Mode=OneWay}" />
                                <Border
                                    Grid.Column="1"
                                    Width="16"
                                    HorizontalAlignment="Left">
                                    <Border.Background>
                                        <media:AcrylicBrush
                                            BlurAmount="16"
                                            TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                            TintOpacity="0.4" />
                                    </Border.Background>
                                </Border>
                                <toolkit:GridSplitter
                                    Grid.Column="1"
                                    Width="16"
                                    HorizontalAlignment="Left"
                                    ResizeBehavior="BasedOnAlignment"
                                    ResizeDirection="Auto" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid
                        Grid.Row="2"
                        Padding="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                        <Button
                            Width="120"
                            Command="{x:Bind NavigateForwardCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE72A;" />
                                <TextBlock Text="Next" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </toolkit:Case>
            <toolkit:Case>
                <toolkit:Case.Value>
                    <x:Int32>10</x:Int32>
                </toolkit:Case.Value>
                <Grid
                    Margin="0,40,0,0"
                    animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                    animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer>
                        <StackPanel
                            Margin="32,0"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="All done!"
                                TextWrapping="WrapWholeWords" />
                            <TextBox
                                MaxWidth="800"
                                Header="Name"
                                Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
                            <TextBox
                                MaxWidth="800"
                                Header="Description"
                                Text="{x:Bind ViewModel.Description, Mode=TwoWay}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid
                        Grid.Row="1"
                        Padding="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                        <Button
                            Width="120"
                            Command="{x:Bind FinishCommand}"
                            Content="Finish"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Grid>
            </toolkit:Case>
        </toolkit:SwitchPresenter>
    </Grid>
</Page>
