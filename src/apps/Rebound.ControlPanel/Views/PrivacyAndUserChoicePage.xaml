<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Rebound.ControlPanel.Views.PrivacyAndUserChoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Rebound.ControlPanel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToInverseVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
    </Page.Resources>
    <Grid>
        <Grid
            Height="72"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Image
                Width="20"
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="/Assets/Glyphs/PrivacyAndUserChoice.png" />
            <TextBlock
                Margin="48,10"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="Privacy and User Choice" />
            <TextBlock Margin="48,40,0,0" Text="Gain control of your computer." />
        </Grid>
        <ScrollViewer Margin="0,72,0,0" Padding="40,0,40,0">
            <StackPanel
                MaxWidth="1000"
                Margin="0,40"
                Spacing="8">
                <InfoBar
                    Title="These settings require administrator privileges to edit."
                    IsClosable="False"
                    IsOpen="True"
                    Visibility="Collapsed">
                    <InfoBar.ActionButton>
                        <Button Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xEA18;" />
                                <TextBlock Text="Relaunch as Administrator" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    Title="About Privacy and User Choice settings"
                    IsClosable="False"
                    IsOpen="True"
                    Message="These options may change across Windows versions and editions. Their availability and behavior can depend on system configuration, updates, policies, and Microsoft services. Review each option carefully to understand what it controls and the potential implications before applying changes." />
                <InfoBar
                    Title="Attention"
                    IsClosable="False"
                    IsOpen="True"
                    Message="Some of these options modify Windows security and system policies and may be flagged by security software. If you're unsure what a setting does, it's best to leave it unchanged. If you don't trust these modifications, read the source code on GitHub."
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button Content="View source code">
                            <interactivity:Interaction.Behaviors>
                                <interactivity:EventTriggerBehavior EventName="Tapped">
                                    <behaviors:NavigateToUriAction NavigateUri="https://github.com/IviriusCommunity/Rebound" />
                                </interactivity:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="User Choice" />
                <InfoBar
                    Title="These settings require administrator privileges to view and edit."
                    IsClosable="False"
                    IsOpen="True"
                    Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind RelaunchAsAdminCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xEA18;" />
                                <TextBlock Text="Relaunch as Administrator" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
                <toolkit:SettingsExpander
                    Description="The Digital Markets Act (DMA) is a European Union regulation designed to promote competition and user choice in digital markets. Enable these settings to unlock extra system control, remove pre-installed bloatware, and restrict background telemetry regardless of your region."
                    Header="European Digital Markets Act (Specific Components)"
                    IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A6;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.ItemsHeader>
                        <InfoBar
                            Title="Attention"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsClosable="False"
                            IsOpen="True"
                            Message="Windows cumulative updates may restore these settings to default since they modify restricted system parameters. Changing these options is safe, but toggles may reset after a major OS update.&#x0A;&#x0A;You will need to restart your computer for these changes to apply."
                            Severity="Warning" />
                    </toolkit:SettingsExpander.ItemsHeader>
                    <toolkit:SettingsExpander.Items>
                        <!--  Edge & Default Apps  -->
                        <toolkit:SettingsCard FontWeight="SemiBold" Header="Microsoft Edge and default applications">
                            <toolkit:SettingsCard.HeaderIcon>
                                <PathIcon Data="F1 m155.601 132.18 2.767 5.324.024-.012.023-.013-2.814-5.299Zm-6.128 2.719-2.089-5.625-.005.002 2.094 5.623Zm-20.754 3.701.02-6h-.02v6ZM77.556 95.627l-6-.066v.066h6Zm9.481-15.79-2.547-5.432-.053.025-.052.025 2.652 5.382Zm33.126 86.12 1.765 5.735.098-.03.097-.034-1.96-5.671Zm38.502-30.538 5.075 3.201.031-.051.031-.051-5.137-3.099Zm-75.56 26.143-3.166 5.096 1.455.904h1.712v-6Zm-13.122-12.32 4.886-3.482-.02-.028-.02-.028-4.846 3.538Zm26.072-71.718-.084 6h.039l.045-6Zm14.858 7.519 4.815-3.58-.004-.005-.005-.007-4.806 3.592Zm-81.86 42.395-5.443 2.525.006.012.006.012 5.43-2.549Zm90.416 38.751 1.901 5.691-3.709-11.412 1.808 5.721Zm-36.305-4.627 3.184-5.085-1.46-.915h-1.724v6Zm51.74-41.065v6h.004l-.004-6Zm17.517-4.8-3.03-5.179-.013.007-.012.008 3.055 5.164Zm17.574-30.596-5.999-.08-.001.035v.035l6 .01Zm-6.532-25.391 5.367-2.682-.016-.031-.015-.031-5.336 2.744ZM95.998 22v6-6ZM22 94.99l-6-.081 12 .166-6-.084Zm70.53-32.388-2.788 5.313.058.03.058.03 2.671-5.373Zm17.863 16.946-5.225 2.95.012.021.012.02 5.201-2.99Zm1.078 36.609-3.373 4.962 3.373-4.962Zm41.362 10.7a48.23 48.23 0 0 1-5.449 2.417l4.177 11.249a60.077 60.077 0 0 0 6.807-3.019l-5.535-10.647Zm-5.454 2.419a52.899 52.899 0 0 1-18.64 3.324l-.041 12a64.865 64.865 0 0 0 22.868-4.079l-4.187-11.245Zm-18.66 3.324c-25.171 0-45.163-17.146-45.163-36.973h-12c0 28.525 27.645 48.973 57.163 48.973v-12ZM83.556 95.693a12.226 12.226 0 0 1 1.743-6.16l-10.288-6.177a24.225 24.225 0 0 0-3.454 12.205l11.999.132Zm1.743-6.16a12.213 12.213 0 0 1 4.615-4.43l-5.754-10.53a24.215 24.215 0 0 0-9.149 8.784L85.3 89.534Zm35.877 82.39.752-.231-3.531-11.469-.751.231 3.53 11.469Zm.947-.295a80.18 80.18 0 0 0 41.617-33.008l-10.151-6.401a68.177 68.177 0 0 1-35.387 28.068l3.921 11.341Zm41.679-33.11a8.311 8.311 0 0 0 1.147-5.185l-11.931 1.286a3.691 3.691 0 0 1 .509-2.299l10.275 6.198Zm1.147-5.185a8.312 8.312 0 0 0-2.226-4.823l-8.717 8.247a3.687 3.687 0 0 1-.988-2.138l11.931-1.286Zm-2.226-4.823a8.31 8.31 0 0 0-4.693