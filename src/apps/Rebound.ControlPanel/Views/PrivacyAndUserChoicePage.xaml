 10.769l6.06 10.357Zm15.027-15.149a41.514 41.514 0 0 0 5.517-20.616l-12-.02a29.52 29.52 0 0 1-3.922 14.659l10.405 5.977Zm5.517-20.545c.195-14.55-5.254-24.33-7.165-28.153l-10.734 5.364c1.905 3.812 6.052 11.267 5.9 22.628l11.999.16Zm-7.196-28.215C155.266 30.65 126.527 16 95.998 16v12c26.935 0 51.035 12.88 62.129 34.454l10.672-5.488ZM95.999 16a79.98 79.98 0 0 0-56.175 23.042l8.427 8.544A67.98 67.98 0 0 1 95.997 28l.001-12ZM39.823 39.042A80.048 80.048 0 0 0 16 94.906l11.998.17a68.048 68.048 0 0 1 20.252-47.49l-8.427-8.544ZM28 95.073c.231-16.857 17.49-32.255 40.25-32.255v-12c-27.19 0-51.901 18.727-52.248 44.09L28 95.073Zm40.25-32.255c1.783 0 12.13.186 21.493 5.097l5.574-10.627c-12.027-6.309-24.804-6.47-27.067-6.47v12Zm21.609 5.157a35.98 35.98 0 0 1 15.31 14.524l10.449-5.901A47.979 47.979 0 0 0 95.2 57.229l-5.342 10.746Zm15.334 14.565c2.75 4.782 3.363 11.338 3.363 14.07h12c0-3.514-.659-12.574-4.961-20.053l-10.402 5.983Zm3.363 14.07c0-.005 0 .034-.006.125a8.485 8.485 0 0 1-.034.358c-.034.305-.09.694-.171 1.16a44.332 44.332 0 0 1-.727 3.315c-.647 2.523-1.515 5.145-2.406 7.054l10.872 5.078c1.316-2.817 2.403-6.21 3.157-9.149.715-2.785 1.315-5.869 1.315-7.94h-12Zm6.289 14.585c.4.272.729.64.954 1.043.215.385.294.724.321.942.026.215.008.353-.002.409a.433.433 0 0 1-.034.111l-10.872-5.078c-1.347 2.883-2.293 8.976 2.887 12.497l6.746-9.924Z" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Allows complete removal of Microsoft Edge from the system." Header="Allow uninstalling Microsoft Edge">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsEdgeUninstallable, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Unlocks standard OS APIs to allow other web browsers to set themselves as default." Header="Disable Edge default browser lock">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EdgeDefaultLock, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Expands Default Apps file type associations, giving some popular file type categories an option to set a default app for multiple extensions at once." Header="Enable expanded default app associations">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.DefaultAppsExtraTypes, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Prevents system campaigns and ads from overriding your choice of default browser when opening web links." Header="Block Edge promotion default browser overrides">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EdgePromotionOverrideDefaultBrowser, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <!--  System Apps & UI Extensions  -->
                        <toolkit:SettingsCard FontWeight="SemiBold" Header="System apps and UI extensions">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8FC;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Allows removal of system Start Experience apps and background web components." Header="Allow uninstalling Start Menu system experiences">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.StartExperiencesUninstallable, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Unlocks regional options in the Microsoft Store, such as app removal support and local catalog features." Header="Enable region-unlocked Microsoft Store features">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.StoreRegionSpecificOptions, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <!--  Copilot  -->
                        <toolkit:SettingsCard FontWeight="SemiBold" Header="Artificial Intelligence">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xF4A5;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Controls whether Windows Copilot integration and its background services are allowed to run." Header="Disable Windows Copilot integration">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.WindowsCopilot, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Prevents the Windows Copilot PWA from being automatically re-pinned to your taskbar during system updates." Header="Block automatic Copilot PWA taskbar pinning">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CopilotPwaPrepin, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <!--  Privacy & Telemetry Restrictions  -->
                        <toolkit:SettingsCard FontWeight="SemiBold" Header="Privacy and telemetry">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xED15;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Enforces strict data privacy restrictions on first-party Windows Widgets feed activity." Header="Restrict Widgets data collection and tracking">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.WidgetsDataRestriction, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Prevents third-party widget providers from accessing background user data and analytics." Header="Restrict third-party Widgets data collection">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ThirdPartyWidgetsDataRestriction, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Requires explicit user consent prompts before syncing Windows settings and data to Microsoft accounts." Header="Enforce explicit account sync consent">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AccountSyncConsent, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Requires explicit consent popups for Online Data Disclosure (ODD) diagnostic tracking." Header="Require explicit Shared ODD diagnostic consent">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SharedOddConsent, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Enforces better layout options in the Windows Privacy settings UI." Header="Show unbiased privacy settings UI layout">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.PrivacyUxModifiedLayout, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <!--  Ads & Promotional Controls  -->
                        <toolkit:SettingsCard FontWeight="SemiBold" Header="Ads and promotional content">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE789;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Disables full-screen promotional ads and upsell screens during Windows setup (OOBE)." Header="Block full-screen setup promotional prompts">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.FullscreenSetupPromotions, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Disables promotional upsell pages embedded inside step-by-step setup flows." Header="Block setup flow promotional pages">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SetupFlowPromotionalPages, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Prevents Microsoft from using telemetry segments to target system-level ad campaigns." Header="Block ad campaign segment targeting">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CampaignSegmentTargeting, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Replaces tailored telemetry experiences with personalized offer controls." Header="Replace &quot;Tailored experiences&quot; with &quot;Personalized offers&quot;">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.PersonalizedOffers, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <!--  System Behaviors & Extras  -->
                        <toolkit:SettingsCard FontWeight="SemiBold" Header="System behaviors and extras">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xF133;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Requires user confirmation before automatically signing apps into Microsoft account credentials." Header="Require confirmation for automatic app sign-in">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutomaticAppSignin, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Controls suggested actions and inline recommendations shown in File Explorer and on Desktop." Header="Disable Recommended Actions in File Explorer">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.RecommendedActions, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Description="Enables the full-screen Xbox handheld and TV-optimized user experience interface." Header="Enable Xbox full-screen experience interface">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.XboxFullscreenExperience, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                    <toolkit:Segmented SelectedIndex="{x:Bind ViewModel.DMAIndex, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay}">
                        <toolkit:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE894;}" ToolTipService.ToolTip="Disable All" />
                        <toolkit:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE70F;}" ToolTipService.ToolTip="Custom" />
                        <toolkit:SegmentedItem Icon="{ui:FontIcon Glyph=&#xE8FB;}" ToolTipService.ToolTip="Enable All" />
                    </toolkit:Segmented>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard
                    Description="This driver enforces protection for certain user-selected preferences, such as default app associations, by preventing unauthorized changes from being applied without explicit user action. Because it operates at a lower system level, some applications that rely on automatically modifying these preferences may not function as expected. Disabling this driver removes this enforcement layer and restores normal application access to these settings.&#x0A;&#x0A;Changing this setting requires a computer restart to apply."
                    Header="User Choice Protection Driver"
                    IsEnabled="{x:Bind ViewModel.IsElevated, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA18;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsUcpdEnabled, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay}" />
                </toolkit:SettingsCard>
                <InfoBar
                    Title="Attention"
                    IsClosable="False"
                    IsOpen="True"
                    Message="Microsoft Store and Windows Update services will not be affected by these policies. It is advised against disabling Windows Update services via brute force as they may be turned on again by automatic repair."
                    Severity="Warning" />
                <toolkit:SettingsExpander Description="Choose the behavior of Windows Update on your system. It is recommended that you keep security updates enabled. This setting will persist throughout your installation and won't be reverted by the system without your consent." Header="Windows Update">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEC76;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.ItemsHeader>
                        <InfoBar
                            Title="Attention"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsClosable="False"
                            IsOpen="True"
                            Message="These options will be ignored if Windows Update is disabled."
                            Severity="Warning" />
                    </toolkit:SettingsExpander.ItemsHeader>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="Windows Update configuration">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xF259;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox SelectedIndex="{x:Bind ViewModel.WindowsUpdateConfig, Mode=TwoWay}">
                                <ComboBoxItem Content="Get updates as soon as they're available" ToolTipService.ToolTip="Get the latest updates as soon as they roll out. This includes gradual rollouts and potentially untested features freshly rolling out of Windows Insider onto the stable channel." />
                                <ComboBoxItem Content="Default" ToolTipService.ToolTip="(Recommended) Get stable updates when they roll out to everyone, alongside driver and application updates." />
                                <ComboBoxItem Content="Important updates only" ToolTipService.ToolTip="Get important Windows feature and security updates only." />
                            </ComboBox>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.WindowsUpdateState, Mode=TwoWay}">
                        <ComboBoxItem Content="Default" ToolTipService.ToolTip="Automatically check for and install updates." />
                        <ComboBoxItem Content="Ask for consent" ToolTipService.ToolTip="(Recommended) Ask for consent before installing updates." />
                        <ComboBoxItem Content="Manual" ToolTipService.ToolTip="Manually check for and install updates." />
                        <ComboBoxItem Content="Disabled" ToolTipService.ToolTip="Disable Windows Update from downloading and installing updates entirely." />
                    </ComboBox>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander Description="Windows AI features such as Copilot in Paint, Windows Recall, Click To Do, etc. These settings are applied using Windows policies and will persist throughout your installation until you change them." Header="AI Features">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xF4A5;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.ItemsHeader>
                        <InfoBar
                            Title="Attention"
                            BorderThickness="0"
                            CornerRadius="0"
                            IsClosable="False"
                            IsOpen="True"
                            Message="AI features such as Recall and Click to Do are fully opt-in and require supported hardware, including a compatible Neural Processing Unit (NPU). On devices that don't meet Microsoft's hardware requirements, these features are unavailable regardless of the settings configured here.&#x0a;&#x0a;Cloud-based AI features, such as Copilot in Paint and Copilot in Notepad, do not require an NPU. These settings will take effect regardless of your hardware."
                            Severity="Warning" />
                    </toolkit:SettingsExpander.ItemsHeader>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Description="Experimental AI program for on-device activity tracking." Header="Recall">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsRecallOn, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Description="Allows Recall to take screenshots of your desktop while running."
                            Header="Recall snapshots"
                            IsEnabled="{x:Bind ViewModel.IsRecallOn, Mode=OneWay}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsRecallSnapshotsOn, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="AI-powered contextual actions for text and images throughout Windows." Header="Click To Do">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsClickToDoOn, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="AI assistance integrated into the Settings app for searching and changing system options using natural language." Header="Copilot in Settings">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CopilotInSettings, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Generative AI features for creative tasks in Paint. This optin includes Cocreator, Generative Fill, and Image Creator." Header="Copilot in Paint">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CopilotInPaint, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="AI writing assistance features integrated into Notepad, including rewrite and summarization tools." Header="Copilot in Notepad">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CopilotInNotepad, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="Security" />
                <toolkit:SettingsCard Description="SmartScreen is a Windows security feature that uses reputation-based checks to help prevent the execution of unrecognized or known malicious apps, scripts, and downloaded files. It acts as an early protection layer before an application is run, complementing other security components such as Microsoft Defender and installed antivirus solutions. Disabling this option removes this reputation-based filtering and may allow unverified files to run without warning." Header="SmartScreen">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE83D;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsSmartScreenEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="sudo for Windows allows you to run commands or applications with administrator privileges without manually opening an elevated terminal or using longer elevation workflows. It provides a familiar sudo-style entry point similar to UNIX systems, including support for elevating within the current session (for example, sudo powershell), while still relying on Windows’ built-in security model and UAC confirmation for permission approval." Header="sudo for Windows">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF760;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SudoLevel, Mode=TwoWay}">
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Inline (Recommended)" />
                        <ComboBoxItem Content="In a new window" />
                        <ComboBoxItem Content="With input disabled" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsExpander Description="Change how Windows handles the execution of script-based automation, including PowerShell execution policies, Windows Script Host availability, and handling of downloaded scripts through Mark-of-the-Web. These settings determine what types of scripts can run, under what trust conditions, and how strongly external script sources are restricted before execution." Header="Execution policies">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8AD;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="PowerShell script execution policy">
                            <ComboBox SelectedIndex="{x:Bind ViewModel.PowerShellLevel, Mode=TwoWay}">
                                <ComboBoxItem Content="Restricted" />
                                <ComboBoxItem Content="Allow all signed scripts" />
                                <ComboBoxItem Content="Allow all local scripts, require signature for remote scripts" />
                                <ComboBoxItem Content="Unrestricted" />
                                <ComboBoxItem Content="Bypass all restrictions" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Windows Script Host">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsScriptHostEnabled, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Enforce Mark-of-the-Web (downloaded scripts)">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsMarkOfTheWebEnabled, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard Description="Enables Windows developer features, including relaxed MSIX/AppX deployment rules for development scenarios, support for installing locally built or test-signed packages, and access to additional debugging and device portal interfaces used for app testing and deployment." Header="Developer Mode">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.DeveloperMode, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="Enables Remote Desktop connections to this device, allowing authorized users to remotely sign in and control the system over the network using the RDP protocol. When disabled, incoming Remote Desktop connections are blocked."
                    Header="Remote Desktop"
                    IsEnabled="False">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AF;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="User Account Control (UAC) is the Windows security mechanism that mediates elevation requests between standard user processes and system-level privileges. It acts as a permission broker that ensures administrative actions require explicit approval before being executed, helping prevent unauthorized or unintended changes to the system. This setting controls how often Windows prompts for consent when applications request elevated access." Header="User Account Control">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA0D;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.UacLevel, Mode=TwoWay}">
                        <ComboBoxItem Content="Always notify me (highest security)" />
                        <ComboBoxItem Content="Notify me only when apps try to make changes to my device" />
                        <ComboBoxItem Content="Notify me only when apps try to make changes (do not dim desktop)" />
                        <ComboBoxItem Content="Never notify (not recommended)" />
                    </ComboBox>
                </toolkit:SettingsCard>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="Privacy" />
                <InfoBar
                    Title="Verify the impact on your privacy"
                    IsClosable="False"
                    IsOpen="True"
                    Message="These settings are labeled by how much impact they have on your privacy, ranging from lowest impact (where it doesn't matter if you keep them on or not) to highest impact (where it's better to turn them off). You can also see if they store data locally or in the cloud with the associated badges.">
                    <StackPanel
                        Margin="0,0,24,24"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Padding="8,4"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="High" />
                        </Border>
                        <Border
                            Padding="8,4"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="Medium" />
                        </Border>
                        <Border
                            Padding="8,4"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="Low" />
                        </Border>
                        <Border
                            Width="1"
                            Margin="0,4"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Border
                            Padding="8,4"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Glyph="&#xE753;" />
                                <TextBlock Foreground="{ThemeResource SystemFillColorAttentionBrush}" Text="Cloud" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="8,4"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Glyph="&#xE977;" />
                                <TextBlock Foreground="{ThemeResource SystemFillColorAttentionBrush}" Text="Local" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </InfoBar>
                <toolkit:SettingsCard Description="Important note: Windows Telemetry is not classified as spyware by mainstream security vendors or security agencies. It refers to diagnostic data collection used to improve system reliability, security, compatibility, and performance. This can include hardware details, system configuration, installed applications, application usage and diagnostics, performance data, device health information, and Microsoft Edge diagnostics. Disabling or limiting telemetry may affect certain features that rely on diagnostic data, such as Windows Insider program functionality and some Microsoft service integrations." Header="Telemetry">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xED15;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="High" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <ComboBox SelectedIndex="{x:Bind ViewModel.TelemetryLevel, Mode=TwoWay}">
                            <ComboBoxItem Content="No diagnostics data" />
                            <ComboBoxItem Content="Required only" />
                            <ComboBoxItem Content="Required + optional" />
                        </ComboBox>
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Allows Windows to use optional diagnostic data to provide personalized tips, recommendations, and suggestions within the operating system and Microsoft services. This may include tailored setup prompts, feature recommendations, and other contextual experiences. In some cases, personalization settings can also influence how Microsoft services display content and advertising." Header="Tailored Experiences">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE771;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="High" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsTailoredExperiencesEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Enables a device-based advertising identifier that apps and some Microsoft services can use to provide personalized advertising and content based on your activity. When enabled, supported apps (including some Windows experiences such as Widgets) may use this identifier to show more relevant ads. Disabling it limits ad personalization based on this identifier." Header="Advertising ID">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF571;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="High" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsAdvertisingIdEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Stores a history of your activity on this device, such as apps you use and documents you open, to enable features like activity continuity and cross-device resume. When enabled and syncing is turned on, some of this data can be associated with your Microsoft account and synchronized across devices. Otherwise, the data remains stored locally on the device." Header="Activity History">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="High" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE977;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsActivityHistoryEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Controls participation in Microsoft’s Customer Experience Improvement Program, which collects additional usage and feature interaction data to help improve Windows and its components. When disabled, Windows reduces optional behavioral data sharing related to how features are used." Header="Customer Experience Improvement Program">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8E1;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="Medium" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsWindowsCeipEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Collects diagnostic information when applications, drivers, or Windows components crash, stop responding, or encounter unexpected errors. Crash reports may be sent to Microsoft and participating software or hardware vendors to help identify bugs, improve reliability, and resolve compatibility issues. Depending on the error, reports may include technical details such as exception information, loaded modules, and memory state at the time of the failure." Header="Error Reporting">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA39;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="Medium" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE977;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsErrorReportingEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Enables cloud-based speech recognition for features such as voice dictation and speech-to-text. When enabled, spoken input is processed using Microsoft’s online speech services to improve accuracy and language understanding. When disabled, speech input is processed locally using on-device recognition models where available." Header="Online Speech Recognition">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEFA9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="Medium" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE977;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsOnlineSpeechRecognitionEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Allows apps and Windows services to access your device's real-time location when permission is granted. This enables features such as weather, maps, and location-based app functionality. Both Microsoft and third-party apps may request location data through the Windows location platform, depending on your permission settings. Disabling this prevents all apps from accessing device location services." Header="Location Services">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xECAF;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="Medium" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsLocationServicesEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Controls whether Microsoft Store apps can send aggregated, anonymized usage and diagnostic data used in Partner Center analytics. This data is processed in a way that removes direct user identification and is not traceable to individual users. It is used by independent developers and companies to understand high-level usage metrics such as app adoption by country or region, app versions in use, feature engagement, performance trends, and reliability signals. This helps developers improve app stability and prioritize updates based on real-world usage patterns." Header="Application Telemetry">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xECAA;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="Low" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsApplicationTelemetryEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Allows anonymized typing and handwriting diagnostic data to be used to improve Microsoft's text input, prediction, and handwriting recognition models. Data sharing may depend on your diagnostic data settings." Header="Help Improve Typing &amp; Inking">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF67B;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="Low" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE753;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsTypingAndInkingDataCollectionEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Allows Windows to build a local language and handwriting model based on your typing, corrections, and pen input. This information is used to improve text prediction, autocorrect, and handwriting recognition on this device." Header="Typing &amp; Inking Personalization">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDC6;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="Low" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE977;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsTypingAndInkingPersonalizationEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Maintains a local index of application launch activity used to improve Search results, Start menu recommendations, and other app discovery features. Windows uses this information to identify frequently used applications and make them easier to access." Header="Application Launches Tracking">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="4">
                            <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="Low" />
                        </Border>
                        <Border
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4">
                            <FontIcon
                                Margin="0,2"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE977;" />
                        </Border>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsApplicationLaunchTrackingEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="Content" />
                <toolkit:SettingsCard Description="Controls whether Windows shows tips, recommendations, and related links within Settings pages. These suggestions help guide users to relevant system features and Microsoft support content based on local usage and system configuration." Header="Suggested content in Settings">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsSuggestedSettingsContentEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Controls whether Windows can show suggested notifications containing tips, feature recommendations, and setup guidance. These notifications are generated by the system to highlight relevant features and improvements based on device state and usage patterns." Header="Suggested notifications">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsSuggestedNotificationsEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Shows occasional tips, feature highlights, and informational messages on the lock screen. These are intended to surface Windows features and usage hints while the device is locked." Header="Lock screen tips">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE82F;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsLockScreenTipsEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Shows tips, feature highlights, and informational prompts in notification form, especially after Windows updates or system changes. These messages introduce new features and help users discover system capabilities following updates." Header="Windows tips">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE897;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsWindowsTipsEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Displays a guided experience after updates or first sign-in, highlighting new features, recommended settings, and changes in Windows. It helps introduce system capabilities and optional setup improvements." Header="Windows Welcome Experience">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsWindowsWelcomeExperienceEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Shows reminders to complete optional setup steps such as account sign-in, backup configuration, and device personalization. These prompts help ensure key Windows features are fully configured." Header="Finish setting up your device">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC76;" />
