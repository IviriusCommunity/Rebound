<Page
    x:Class="Rebound.ControlPanel.Views.DisplaySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Rebound.ControlPanel.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter
            x:Key="BoolToInverseVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="BrushSurface"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
        <Grid VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Image
                Width="16"
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="/Assets/Glyphs/Display.ico" />
            <TextBlock
                Margin="48,10,16,0"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="Display"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Margin="48,36,16,12"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Display color calibration tools and ClearType font rendering options."
                TextWrapping="WrapWholeWords" />
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="40,0">
            <StackPanel
                MaxWidth="1000"
                Margin="0,40"
                Spacing="8">
                <toolkit:SettingsCard
                    Description="Manage the settings that don't appear here."
                    Header="Windows Settings"
                    IsClickEnabled="True">
                    <interactivity:Interaction.Behaviors>
                        <interactivity:EventTriggerBehavior EventName="Tapped">
                            <behaviors:NavigateToUriAction NavigateUri="ms-settings:display" />
                        </interactivity:EventTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="/Assets/Glyphs/WindowsSettings.ico" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="Color profiles" />
                <toolkit:SettingsCard
                    Command="{x:Bind BeginDisplayColorCalibrationCommand}"
                    Description="Create a new color profile for your display. Adjust brightness, saturation, and gamma."
                    Header="Display Color Calibration (SDR Calibration)"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="/Assets/Apps/DisplayColorCalibration.ico" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>
                <InfoBar
                    Title="To add or remove color profiles, head to Settings &gt; Display &gt; Color profiles."
                    IsClosable="False"
                    IsOpen="True" />
                <toolkit:SettingsCard
                    Command="{x:Bind ViewModel.HDRCalibration.OpenCommand, Mode=OneWay}"
                    Description="Windows utility designed to create HDR color profiles for supported displays. Not affiliated with Rebound."
                    Header="Windows HDR Calibration"
                    IsClickEnabled="{x:Bind ViewModel.HDRCalibration.IsInstalled, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="/Assets/Apps/WindowsHDRCalibration.png" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                    <Grid>
                        <Button
                            Width="120"
                            Command="{x:Bind ViewModel.HDRCalibration.InstallCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.HDRCalibration.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE896;" />
                                <TextBlock Text="Install" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </toolkit:SettingsCard>
                <TextBlock
                    Margin="0,32,0,0"
                    FontWeight="SemiBold"
                    Text="Font settings" />
                <InfoBar Title="Refresh Win32 apps to apply changes now." IsOpen="{x:Bind ViewModel.IsRefreshRequired, Mode=TwoWay}">
                    <InfoBar.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </InfoBar.Transitions>
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
                <toolkit:SettingsCard Description="Controls the antialiasing method applied to text in Win32 applications. ClearType uses subpixel rendering for sharper text on LCD displays." Header="Font smoothing">
                    <toolkit:SettingsCard.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </toolkit:SettingsCard.Transitions>
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF17F;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.FontSmoothingType, Mode=TwoWay}">
                        <ComboBoxItem>None</ComboBoxItem>
                        <ComboBoxItem>Standard</ComboBoxItem>
                        <ComboBoxItem>ClearType</ComboBoxItem>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="Adjusts the intensity of ClearType subpixel rendering. Higher values produce stronger color fringing on text edges, lower values produce a more neutral appearance."
                    Header="ClearType level"
                    Visibility="{x:Bind ViewModel.IsClearTypeEnabled, Mode=OneWay}">
                    <toolkit:SettingsCard.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </toolkit:SettingsCard.Transitions>
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="/Assets/Apps/ClearType.ico" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Slider
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.ClearTypeLevel, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="Controls the gamma correction applied to font rendering. Lower values produce lighter text, higher values produce darker text. The default of 1400 is suitable for most displays."
                    Header="Gamma"
                    Visibility="{x:Bind ViewModel.IsClearTypeEnabled, Mode=OneWay}">
                    <toolkit:SettingsCard.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </toolkit:SettingsCard.Transitions>
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7A1;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Slider
                        Maximum="2200"
                        Minimum="1000"
                        StepFrequency="10"
                        Value="{x:Bind ViewModel.ClearTypeGamma, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="Specifies the physical arrangement of color elements on your display. RGB is standard for most monitors. Select BGR if text appears with colored fringes after enabling ClearType."
                    Header="Subpixel layout"
                    Visibility="{x:Bind ViewModel.IsClearTypeEnabled, Mode=OneWay}">
                    <toolkit:SettingsCard.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </toolkit:SettingsCard.Transitions>
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SubpixelLayout, Mode=TwoWay}">
                        <ComboBoxItem>RGB</ComboBoxItem>
                        <ComboBoxItem>BGR</ComboBoxItem>
                    </ComboBox>
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
